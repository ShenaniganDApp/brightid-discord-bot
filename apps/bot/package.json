{
  "name": "@brightidbot/bot",
  "version": "1.5.1",
  "description": "Bot to assign bright-id verified role",
  "type": "module",
  "scripts": {
    "lint": "npx eslint ./src",
    "test": "npx jest",
    "test:qr": "node --test test/verify-qr.test.mjs",
    "start": "node src/Bot.mjs",
    "dev": "nodemon src/Bot.mjs",
    "build:rescript": "rescript build",
    "watch:rescript": "rescript build -w",
    "prettify": "prettier . --write",
    "deploy-commands": "node src/DeployCommands.mjs"
