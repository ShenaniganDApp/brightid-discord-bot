    "prettier": "^2.1.2"
  },
  "engines":{
    "node": "22.x"
  },
  "dependencies": {
    "@brightidbot/shared": "*",
    "@brightidbot/utils": "*",
    "@discordjs/builders": "^0.13.0",
    "@discordjs/rest": "^0.4.1",
    "@glennsl/rescript-json-combinators": "^1.4.0",
    "brightid_sdk_v5": "^1.0.2",
    "discord-api-types": "^0.32.0",
    "discord.js": "13.15.0",
    "fast-json-stable-stringify": "^2.1.0",
    "node-fetch": "^2.6.1",
    "qrcode": "^1.4.4",
    "tweetnacl": "^1.0.3",
    "tweetnacl-util": "^0.15.1"
